# Modelo de configuração. NÃO coloque valores reais aqui: este arquivo é
# versionado e o repositório é público.
#
# Desenvolvimento: `npm run preparar` cria o .env.local com segredos
# aleatórios (e nunca sobrescreve um existente).
# Produção: os valores ficam só no ambiente do servidor.

# --- Marca e endereços -------------------------------------------------
NEXAKEEP_MARCA=Nexakeep
# Só o domínio, com porta opcional. Lojas viram <slug>.<domínio>.
NEXAKEEP_DOMINIO_BASE=localhost:3000
# Produção exige https.
NEXAKEEP_PROTOCOLO=http

# --- Banco ---------------------------------------------------------------
# Papel da aplicação: sem superusuário e sem BYPASSRLS.
DATABASE_URL=
# Papel que aplica migrações. Só scripts; a aplicação nunca usa.
DATABASE_URL_MIGRACAO=

# --- Autenticação ---------------------------------------------------------
# 32+ caracteres aleatórios (ex.: openssl rand -base64 32).
BETTER_AUTH_SECRET=
# Rotação: manter BETTER_AUTH_SECRET original para ler dados legados.
# BETTER_AUTH_SECRETS usa versão:segredo, separados por vírgula, versão atual primeiro.
# Ex.: 2:<novo segredo>,1:<segredo anterior>. Nunca reutilizar versões.
# Manter chaves anteriores enquanto houver TOTP/reservas/backups cifrados com elas.
# A troca da chave atual exige novo login (cookies antigos deixam de valer).
BETTER_AUTH_SECRETS=

# Cabeçalho com o IP real do cliente, sobrescrito pelo proxy da VPS.
NEXAKEEP_CABECALHO_IP=x-real-ip

# --- E-mail -----------------------------------------------------------------
# "arquivo" grava as mensagens em NEXAKEEP_DADOS_LOCAIS/emails (desenvolvimento).
NEXAKEEP_EMAIL_TRANSPORTE=arquivo
NEXAKEEP_EMAIL_REMETENTE=Nexakeep <acesso@nexakeep.site>

# --- Dados locais -------------------------------------------------------------
# Banco de desenvolvimento e e-mails gravados. Fica FORA do repositório e do
# OneDrive. Vazio = %LOCALAPPDATA%\Nexakeep (Windows) ou ~/.local/share/nexakeep.
NEXAKEEP_DADOS_LOCAIS=

# --- Banco local de desenvolvimento (só scripts/bd-local.ts) --------------------
NEXAKEEP_BD_PORTA=54329
NEXAKEEP_BD_SENHA_ADMIN=
NEXAKEEP_BD_SENHA_MIGRADOR=
NEXAKEEP_BD_SENHA_APP=
